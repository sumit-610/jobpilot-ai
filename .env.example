# ── Database ───────────────────────────────────────────────────────────────
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_dev
POSTGRES_DB=jobpilot
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot_dev@db:5432/jobpilot

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Clerk (auth) — get from dashboard.clerk.com ───────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_ISSUER=https://your-clerk-domain.clerk.accounts.dev

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o

# ── Pinecone (optional — can use pgvector locally) ─────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=jobpilot-jobs

# ── App config ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-this-in-production
CORS_ORIGINS=http://localhost:3000

# ── Job scraper schedule ────────────────────────────────────────────────────
SCRAPE_HOUR=7
SCRAPE_MINUTE=52
JOB_SCORE_THRESHOLD=60
MAX_JOBS_PER_DIGEST=20

# ── Notifications (optional for MVP) ────────────────────────────────────────
SENDGRID_API_KEY=
EMAIL_FROM=noreply@jobpilot.ai
